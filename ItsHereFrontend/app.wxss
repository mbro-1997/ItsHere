page {
  min-height: 100vh;
  background: #f5f8f6;
  color: #202828;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
}

.page {
  min-height: 100vh;
  padding: 28rpx;
  box-sizing: border-box;
}

.title {
  font-size: 48rpx;
  line-height: 1.15;
  font-weight: 900;
}

.hint {
  margin-top: 10rpx;
  color: #8a9697;
  font-size: 26rpx;
  line-height: 1.5;
  font-weight: 700;
}

.card {
  margin-top: 24rpx;
  padding: 28rpx;
  border-radius: 28rpx;
  background: #fff;
  border: 1rpx solid #edf2f0;
  box-shadow: 0 12rpx 30rpx rgba(17, 24, 39, 0.04);
}

.primary-btn {
  height: 96rpx;
  border-radius: 48rpx;
  background: #0f9276;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 900;
}

.secondary-btn {
  height: 76rpx;
  border-radius: 38rpx;
  background: #e9f8f1;
  color: #0f9276;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 900;
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.pill {
  display: inline-flex;
  align-items: center;
  height: 52rpx;
  padding: 0 20rpx;
  border-radius: 26rpx;
  background: #e9f8f1;
  color: #0f9276;
  font-size: 24rpx;
  font-weight: 900;
}

.global-loader {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 9999;
  display: flex;
  align-items: center;
  justify-content: center;
  pointer-events: none;
}

.global-loader::before {
  content: "";
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(245, 248, 246, 0.28);
}

.global-loader-box {
  position: relative;
  width: 220rpx;
  height: 150rpx;
  border-radius: 30rpx;
  background: rgba(255, 255, 255, 0.88);
  box-shadow: 0 18rpx 60rpx rgba(17, 24, 39, 0.12);
  display: flex;
  align-items: center;
  justify-content: center;
}

.global-loader-image {
  width: 190rpx;
  height: 108rpx;
}
