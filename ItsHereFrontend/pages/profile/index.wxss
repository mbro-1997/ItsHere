.profile { display: flex; align-items: center; gap: 22rpx; }
.avatar {
  width: 132rpx;
  height: 116rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}
.avatar-rider { width: 132rpx; height: 104rpx; }
.small { font-size: 34rpx; }
.module {
  margin-top: 24rpx;
  min-height: 150rpx;
  padding: 26rpx;
  border-radius: 30rpx;
  display: grid;
  grid-template-columns: 92rpx minmax(0, 1fr) 34rpx;
  align-items: center;
  gap: 22rpx;
  box-shadow: 0 14rpx 36rpx rgba(17, 24, 39, 0.06);
  border: 1rpx solid rgba(255, 255, 255, 0.72);
  box-sizing: border-box;
}
.brand-module { background: linear-gradient(135deg, #e8f9f0 0%, #ffffff 78%); }
.suggestion-module { background: linear-gradient(135deg, #eef4ff 0%, #ffffff 78%); }
.place-module { background: linear-gradient(135deg, #e7f6fb 0%, #ffffff 78%); }
.review-module { background: linear-gradient(135deg, #fff5dc 0%, #ffffff 78%); }
.module-icon {
  width: 92rpx;
  height: 92rpx;
  border-radius: 28rpx;
  background: #fff;
  border: 7rpx solid #102126;
  box-sizing: border-box;
  position: relative;
  overflow: hidden;
}
.brand-icon {
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 8rpx;
  padding: 14rpx;
}
.icon-line {
  height: 12rpx;
  border-radius: 999rpx;
}
.icon-line.green { background: #38d3a2; }
.icon-line.blue { width: 70%; background: #55bddd; }
.icon-line.yellow { background: #ffd36d; }
.suggestion-icon {
  background: #eef4ff;
}
.suggestion-bubble {
  position: absolute;
  left: 17rpx;
  top: 18rpx;
  width: 46rpx;
  height: 34rpx;
  border-radius: 12rpx;
  background: #55bddd;
  border: 6rpx solid #102126;
  box-sizing: border-box;
}
.suggestion-bubble::after {
  content: "";
  position: absolute;
  left: 7rpx;
  bottom: -12rpx;
  width: 14rpx;
  height: 14rpx;
  background: #55bddd;
  border-left: 6rpx solid #102126;
  border-bottom: 6rpx solid #102126;
  transform: rotate(-18deg);
}
.suggestion-plus {
  position: absolute;
  right: 15rpx;
  bottom: 17rpx;
  border-radius: 999rpx;
  background: #38d3a2;
  border: 4rpx solid #102126;
  box-sizing: border-box;
}
.suggestion-plus.vertical {
  width: 16rpx;
  height: 40rpx;
}
.suggestion-plus.horizontal {
  right: 3rpx;
  bottom: 29rpx;
  width: 40rpx;
  height: 16rpx;
}
.place-icon {
  overflow: hidden;
  border-radius: 28rpx;
  background: #e7f6fb;
}
.pin-dot {
  position: absolute;
  left: 28rpx;
  top: 16rpx;
  width: 26rpx;
  height: 26rpx;
  border-radius: 50%;
  background: #55bddd;
  border: 6rpx solid #102126;
  z-index: 2;
}
.pin-base {
  position: absolute;
  left: 17rpx;
  right: 17rpx;
  bottom: 14rpx;
  height: 30rpx;
  border-radius: 10rpx;
  background: #38d3a2;
  border: 6rpx solid #102126;
  box-sizing: border-box;
}
.review-icon {
  background: #ffd36d;
  display: flex;
  align-items: center;
  justify-content: center;
}
.star-core {
  color: #102126;
  font-size: 48rpx;
  line-height: 1;
}
.module-main { min-width: 0; }
.module-title { color: #202828; font-size: 34rpx; font-weight: 900; }
.module-subtitle { margin-top: 10rpx; color: #748182; font-size: 24rpx; line-height: 1.4; font-weight: 800; }
.module-arrow { color: #9aa5a6; font-size: 48rpx; font-weight: 900; text-align: right; }
