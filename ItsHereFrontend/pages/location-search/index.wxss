.search-page {
  min-height: 100vh;
  padding: 24rpx;
  background: #f5f8f6;
}

.search-bar {
  position: sticky;
  top: 0;
  z-index: 5;
  padding: 12rpx 0 20rpx;
  background: #f5f8f6;
}

.search-input {
  height: 88rpx;
  padding: 0 28rpx;
  border-radius: 44rpx;
  background: #fff;
  color: #101818;
  font-size: 30rpx;
  font-weight: 900;
  box-shadow: 0 12rpx 30rpx rgba(17, 24, 39, 0.05);
}

.status {
  padding: 30rpx 10rpx;
  color: #8a9697;
  font-size: 26rpx;
  font-weight: 800;
}

.suggestion-list {
  border-radius: 28rpx;
  background: #fff;
  overflow: hidden;
  box-shadow: 0 12rpx 30rpx rgba(17, 24, 39, 0.04);
}

.suggestion-item {
  padding: 28rpx;
  border-bottom: 1rpx solid #edf2f0;
}

.suggestion-item:last-child {
  border-bottom: 0;
}

.suggestion-title {
  color: #101818;
  font-size: 30rpx;
  line-height: 1.3;
  font-weight: 900;
}

.suggestion-address {
  margin-top: 8rpx;
  color: #8a9697;
  font-size: 24rpx;
  line-height: 1.35;
  font-weight: 700;
}
