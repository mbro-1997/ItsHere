.map {
  height: 420rpx;
  width: calc(100% + 56rpx);
  margin: -28rpx -28rpx 0;
}

.loading-card {
  margin-top: 120rpx;
  padding: 40rpx;
  border-radius: 28rpx;
  background: #fff;
  color: #8a9697;
  font-weight: 900;
  text-align: center;
}

.detail-title { font-size: 40rpx; }
.tag-row { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 20rpx; }
.tag-pill.public-tag { background: #e9f8f1; color: #0f9276; }
.tag-pill.private-tag { background: #e7f3ff; color: #2474a6; }
.field { display: grid; grid-template-columns: 150rpx minmax(0, 1fr); gap: 18rpx; padding: 24rpx 0; border-bottom: 1rpx solid #edf2f0; font-size: 26rpx; font-weight: 800; }
.field text { color: #8a9697; }
.review-section { padding: 26rpx 0; border-bottom: 1rpx solid #edf2f0; }
.section-title { color: #8a9697; font-size: 26rpx; font-weight: 900; }
.review-empty { margin-top: 16rpx; color: #8a9697; font-size: 26rpx; font-weight: 800; }
.review-card { margin-top: 18rpx; padding: 22rpx; border-radius: 24rpx; background: #f7faf9; border: 1rpx solid #edf2f0; }
.review-top { display: flex; align-items: flex-start; justify-content: space-between; gap: 18rpx; }
.review-badge { display: inline-flex; align-items: center; height: 46rpx; padding: 0 18rpx; border-radius: 23rpx; font-size: 23rpx; font-weight: 900; }
.review-badge.private { background: #fff4d8; color: #9a6a00; }
.review-badge.public { background: #e9f8f1; color: #0f9276; }
.review-user { margin-top: 10rpx; color: #667273; font-size: 24rpx; font-weight: 800; }
.review-side { text-align: right; flex: 0 0 auto; }
.review-stars { color: #f0b429; font-size: 24rpx; font-weight: 900; }
.review-time { margin-top: 8rpx; color: #9aa5a6; font-size: 22rpx; font-weight: 700; }
.review-content { margin-top: 18rpx; color: #202828; font-size: 28rpx; line-height: 1.55; font-weight: 800; word-break: break-all; }
.actions { display: grid; grid-template-columns: 1fr 1fr; gap: 18rpx; margin-top: 18rpx; }
