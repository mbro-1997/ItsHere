<view class="page">
  <map
    wx:if="{{place}}"
    class="map"
    latitude="{{place.latitude}}"
    longitude="{{place.longitude}}"
    markers="{{markers}}"
    scale="16"
  />
  <view wx:else class="loading-card">正在加载点位详情...</view>
  <view class="card" wx:if="{{place}}">
    <view class="title detail-title">{{place.name}}</view>
    <view class="tag-row">
      <text class="pill">{{place.businessCategory}}</text>
      <text class="pill">{{place.brandName}}</text>
      <text class="pill" wx:if="{{place.distanceMeters}}">距路线 {{place.distanceMeters}}m</text>
      <text class="pill tag-pill {{item.visibility === 'public' ? 'public-tag' : 'private-tag'}}" wx:for="{{tagBadges}}" wx:key="name">{{item.name}}</text>
    </view>
    <view class="field"><text>详细地址</text><view>{{place.address}}</view></view>
    <view class="field"><text>电话</text><view>{{place.phone || '暂无'}}</view></view>
    <view class="review-section">
      <view class="section-title">评价</view>
      <view class="review-empty" wx:if="{{reviews.length === 0}}">暂无评价</view>
      <view class="review-card" wx:for="{{reviews}}" wx:key="id">
        <view class="review-top">
          <view>
            <view class="review-badge {{item.visibility === 'public' ? 'public' : 'private'}}">{{item.visibilityText}}</view>
            <view class="review-user">{{item.reviewerText}}</view>
          </view>
          <view class="review-side">
            <view class="review-stars">{{item.stars}}</view>
            <view class="review-time">{{item.timeText}}</view>
          </view>
        </view>
        <view class="review-content">{{item.content}}</view>
      </view>
    </view>
    <view class="primary-btn" bindtap="onCopyAddress">复制地址</view>
    <view class="actions">
      <view class="secondary-btn" bindtap="onWriteReview">写评价</view>
      <view class="secondary-btn" bindtap="onEditTags">标签管理</view>
    </view>
  </view>
</view>
<view wx:if="{{globalLoading}}" class="global-loader">
  <view class="global-loader-box">
    <image class="global-loader-image" src="/assets/rider-loader-bounce.svg" mode="aspectFit" />
  </view>
</view>
