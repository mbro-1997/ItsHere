<view class="page">
  <view class="title">品牌配置</view>
  <view class="hint">打开的品牌会参与后端顺路查询。</view>
  <scroll-view class="category-scroll" scroll-x wx:if="{{brands.length > 0}}">
    <view class="category-tabs">
      <view
        wx:for="{{categories}}"
        wx:key="*this"
        class="category-tab {{activeCategory === item ? 'active' : ''}}"
        data-category="{{item}}"
        bindtap="onSelectCategory"
      >{{item}}</view>
    </view>
  </scroll-view>
  <view class="card empty" wx:if="{{loginMissing}}">登录未完成，暂时无法读取品牌配置。</view>
  <view class="card empty" wx:elif="{{loadFailed}}">品牌加载失败，请确认后端已启动。</view>
  <view class="card empty" wx:elif="{{brands.length === 0}}">暂无品牌配置，请确认 poi_brands 已导入。</view>
  <view class="card empty" wx:elif="{{visibleBrands.length === 0}}">当前分类下暂无品牌。</view>
  <view class="card brand-row" wx:for="{{visibleBrands}}" wx:key="id">
    <view class="mark">{{item.mark}}</view>
    <view>
      <view class="name">{{item.name}}</view>
      <view class="hint compact">{{item.meta}}</view>
    </view>
    <switch checked="{{item.enabled}}" color="#0f9276" data-id="{{item.id}}" bindchange="onToggle" />
  </view>
</view>
<view wx:if="{{globalLoading}}" class="global-loader">
  <view class="global-loader-box">
    <image class="global-loader-image" src="/assets/rider-loader-bounce.svg" mode="aspectFit" />
  </view>
</view>
