.route-page {
  position: relative;
  height: 100vh;
  padding: 0;
  overflow: hidden;
}

.map {
  width: 100%;
  height: 100vh;
  display: block;
}

.small { font-size: 36rpx; }
.compact { width: 160rpx; height: 64rpx; font-size: 24rpx; }

.result-sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 8;
  box-sizing: border-box;
  padding: 24rpx 28rpx calc(28rpx + env(safe-area-inset-bottom));
  border-radius: 34rpx 34rpx 0 0;
  background: rgba(255, 255, 255, 0.97);
  border: 1rpx solid #edf2f0;
  box-shadow: 0 -18rpx 60rpx rgba(17, 24, 39, 0.12);
  transition: height 260ms cubic-bezier(.2, .82, .25, 1), transform 260ms cubic-bezier(.2, .82, .25, 1);
  overflow: hidden;
}

.result-sheet.expanded {
  height: 62vh;
}

.result-sheet.collapsed {
  height: 176rpx;
}

.result-sheet.dragging {
  transition: none;
}

.sheet-drag-area {
  height: 42rpx;
  display: flex;
  align-items: flex-start;
  justify-content: center;
}

.sheet-handle {
  width: 88rpx;
  height: 12rpx;
  margin-top: 0;
  border-radius: 999rpx;
  background: #d2dad7;
}

.sheet-head {
  min-height: 72rpx;
}

.sheet-list {
  height: calc(100% - 150rpx - env(safe-area-inset-bottom));
}

.result-sheet.collapsed .sheet-list {
  height: 0;
  opacity: 0;
}

.place-row {
  display: grid;
  grid-template-columns: 76rpx minmax(0, 1fr) 120rpx;
  gap: 18rpx;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #edf2f0;
}

.mark {
  width: 76rpx;
  height: 76rpx;
  border-radius: 24rpx;
  background: #e9f8f1;
  color: #0f9276;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  font-weight: 900;
}

.place-main { min-width: 0; }
.place-name { font-size: 30rpx; font-weight: 900; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.place-meta { margin-top: 8rpx; color: #8a9697; font-size: 24rpx; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.place-side { color: #0f9276; text-align: right; font-weight: 900; }
.copy { margin-top: 18rpx; font-size: 24rpx; }
.badge { display: inline-flex; margin: 10rpx 8rpx 0 0; padding: 6rpx 14rpx; border-radius: 20rpx; background: #edf2f0; color: #667273; font-size: 22rpx; font-weight: 900; }
.badge.review { background: #fff4d8; color: #9a6a00; }
.badge.public-tag { background: #e9f8f1; color: #0f9276; }
.badge.private-tag { background: #e7f3ff; color: #2474a6; }
.empty { padding: 36rpx 0; color: #8a9697; font-weight: 800; text-align: center; }

.marker-popup {
  position: absolute;
  left: 28rpx;
  right: 28rpx;
  top: 250rpx;
  z-index: 12;
  padding: 26rpx;
  border-radius: 30rpx;
  background: rgba(255, 255, 255, 0.96);
  border: 1rpx solid #edf2f0;
  box-shadow: 0 22rpx 70rpx rgba(17, 24, 39, 0.16);
  animation: jellyPop 360ms cubic-bezier(.18, .9, .25, 1.18);
  transform-origin: 50% 70%;
}

.popup-close {
  position: absolute;
  right: 22rpx;
  top: 18rpx;
  width: 48rpx;
  height: 48rpx;
  border-radius: 24rpx;
  background: #f0f4f3;
  color: #778485;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  font-weight: 900;
}

.popup-head {
  display: grid;
  grid-template-columns: 76rpx minmax(0, 1fr);
  gap: 18rpx;
  align-items: center;
  padding-right: 54rpx;
}

.popup-mark {
  background: #dcf8ef;
}

.popup-main {
  min-width: 0;
}

.popup-title {
  color: #202828;
  font-size: 32rpx;
  line-height: 1.25;
  font-weight: 900;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.popup-meta {
  margin-top: 8rpx;
  color: #0f9276;
  font-size: 24rpx;
  font-weight: 900;
}

.popup-address {
  margin-top: 18rpx;
  color: #7d898a;
  font-size: 25rpx;
  line-height: 1.45;
  font-weight: 700;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.popup-badges {
  min-height: 14rpx;
}

.popup-actions {
  display: grid;
  grid-template-columns: 180rpx minmax(0, 1fr);
  gap: 16rpx;
  margin-top: 22rpx;
}

.popup-copy,
.popup-detail {
  height: 74rpx;
  font-size: 26rpx;
}

@keyframes jellyPop {
  0% {
    opacity: 0;
    transform: scale(.72) translateY(18rpx);
  }
  58% {
    opacity: 1;
    transform: scale(1.06) translateY(-4rpx);
  }
  78% {
    transform: scale(.97) translateY(0);
  }
  100% {
    opacity: 1;
    transform: scale(1) translateY(0);
  }
}
