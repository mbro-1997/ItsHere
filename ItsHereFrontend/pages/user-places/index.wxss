.add { width: 160rpx; }
.place-swipe { position: relative; overflow: hidden; border-radius: 28rpx; }
.place { position: relative; z-index: 2; transition: transform 220ms ease; }
.place.swiping { transition: none; }
.place-content { min-width: 0; }
.name { font-size: 30rpx; font-weight: 900; }
.place-info { margin-top: 10rpx; color: #8a9697; font-size: 24rpx; line-height: 1.45; font-weight: 800; word-break: break-all; }
.delete-action { position: absolute; top: 24rpx; right: 0; bottom: 0; width: 136rpx; min-height: 132rpx; border-radius: 26rpx; background: #f05d5e; color: #fff; display: flex; align-items: center; justify-content: center; font-size: 28rpx; font-weight: 900; z-index: 1; }
.section-label { color: #0f9276; font-size: 24rpx; font-weight: 900; }
.selected-card { display: flex; flex-direction: column; gap: 22rpx; }
.readonly-row { padding: 22rpx; border-radius: 22rpx; background: #f7faf9; }
.readonly-label { color: #8a9697; font-size: 24rpx; font-weight: 800; }
.readonly-value { margin-top: 8rpx; color: #202828; font-size: 30rpx; line-height: 1.45; font-weight: 900; word-break: break-all; }
.action-row { display: grid; grid-template-columns: 180rpx minmax(0, 1fr); gap: 18rpx; }
.ghost { height: 88rpx; }
.save { height: 88rpx; }
.empty { color: #8a9697; font-size: 26rpx; line-height: 1.5; font-weight: 800; }
