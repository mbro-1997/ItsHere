.filter-page {
  padding-bottom: 190rpx;
}

.search {
  height: 76rpx;
  margin-top: 22rpx;
  padding: 0 24rpx;
  border-radius: 38rpx;
  background: #fff;
  color: #202828;
  display: flex;
  align-items: center;
  font-weight: 900;
}

.tabs-scroll {
  width: 100%;
  margin-top: 20rpx;
  white-space: nowrap;
}

.tabs {
  display: inline-flex;
  gap: 12rpx;
  min-width: 100%;
}

.tab {
  flex: 0 0 auto;
  height: 72rpx;
  padding: 0 24rpx;
  border-radius: 36rpx;
  background: #fff;
  color: #778485;
  display: flex;
  align-items: center;
  font-weight: 900;
}

.tab.active {
  background: #0f9276;
  color: #fff;
}

.option {
  display: grid;
  grid-template-columns: 76rpx minmax(0, 1fr) auto;
  align-items: center;
  gap: 18rpx;
}

.mark {
  width: 76rpx;
  height: 76rpx;
  border-radius: 24rpx;
  background: #e9f8f1;
  color: #0f9276;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  font-weight: 900;
}

.place-name { font-size: 30rpx; font-weight: 900; }
.place-meta { margin-top: 8rpx; color: #8a9697; font-size: 24rpx; }
.bottom {
  position: fixed;
  left: 28rpx;
  right: 28rpx;
  bottom: calc(34rpx + env(safe-area-inset-bottom));
  z-index: 20;
  box-shadow: 0 16rpx 42rpx rgba(15, 146, 118, 0.22);
}
